# ===== OBRIGATÓRIAS =====
# Banco PostgreSQL (Supabase, Neon, Railway...). No Supabase use a "Connection string" (porta 5432 ou pooler 6543 com ?pgbouncer=true)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
# Endereço público do site, com https e sem barra no final
APP_URL="https://www.seudominio.com.br"

# ===== MERCADO PAGO (assinaturas) =====
# Painel do desenvolvedor > Suas integrações > Credenciais de PRODUÇÃO > Access Token
MP_ACCESS_TOKEN=""
# Painel do desenvolvedor > Webhooks > "Assinatura secreta" (gerada ao configurar a URL do webhook)
MP_WEBHOOK_SECRET=""

# ===== E-MAIL (recuperação de senha) =====
# Qualquer SMTP: Gmail (senha de app), Brevo, Resend, Zoho...
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sergio Eletricista <nao-responda@seudominio.com.br>"
